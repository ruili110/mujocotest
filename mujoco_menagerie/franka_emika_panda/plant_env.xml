<mujoco model="plant_environment">
    <!-- 将角度设置为 degree，这样你之前的 euler="90 0 0" 才能正常生效 -->
    <compiler angle="radian" meshdir="assets" autolimits="true"/>
    <option integrator="implicitfast"/>
    <!-- Native D405 color frame size used before farm resizes to 96x96. -->
    <visual>
        <global offwidth="848" offheight="480"/>
        <!-- The real D405 observes an illuminated plant. Ambient camera light
             keeps the thin, mostly vertical leaves green instead of black. -->
        <headlight ambient="0.45 0.45 0.45" diffuse="0.65 0.65 0.65" specular="0.1 0.1 0.1"/>
    </visual>
    
    <asset>
        <!-- 确保你的 stl 文件放在与此 xml 相同的目录或 assets 文件夹下 -->
        <!-- plant_pot.stl bounds are 74 x 74 x 75 model units. These scales
             produce an exact visible footprint/height of 18.5 x 34 x 10 cm. -->
        <mesh name="my_pot_mesh" file="plant_pot.stl"
              scale="0.0025 0.0045945945946 0.0013333333333"/>
        <!-- plant.stl is rotated 90 degrees around X below, so mesh Y becomes
             world height. The Y scale gives exactly 31 cm visible height;
             the two horizontal scales retain the existing plant width. -->
        <mesh name="my_plant_mesh" file="plant.stl" scale="0.03 0.055724011339 0.03"/>
        <material name="my_pot_mat" rgba="0.8 0.45 0.3 1"/>
        <material name="my_plant_mat" rgba="0.2 0.6 0.1 1"/>
    </asset>

    <worldbody>
        <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
        <geom type="plane" size="1 1 0.1" rgba="0.9 0.9 0.9 1"/>

        <!-- 55 cm x 40 cm x 30 cm support box, centered below the pot -->
        <geom name="support_box" type="box" pos="0.5 0 0.15" size="0.2 0.275 0.15"
              rgba="0 0 0 1" contype="1" conaffinity="1"/>

        <!-- 纯视觉花盆 + 隐藏的物理内胆 -->
        <body name="pot" pos="0.5 0 0.3">
            <inertial pos="0 0 0.0375" mass="0.4" diaginertia="0.004751 0.000918 0.005294"/>
            <geom type="mesh" mesh="my_pot_mesh" material="my_pot_mat" contype="0" conaffinity="0"/>
            <!-- Floor and four tapered walls leave the pot cavity open to the gripper. -->
            <geom name="pot_collision" type="box" size="0.05 0.125 0.001" pos="0 0 0.001"
                  rgba="1 0 0 1" contype="1" conaffinity="1"/>
            <geom name="pot_wall_pos_x" type="box" size="0.003 0.185 0.03848"
                  pos="0.05915 0 0.0375" euler="0 0.3171 0"
                  rgba="1 0 0 1" contype="1" conaffinity="1"/>
            <geom name="pot_wall_neg_x" type="box" size="0.003 0.185 0.03848"
                  pos="-0.05915 0 0.0375" euler="0 -0.3171 0"
                  rgba="1 0 0 1" contype="1" conaffinity="1"/>
            <geom name="pot_wall_pos_y" type="box" size="0.074 0.0075 0.04416"
                  pos="0 0.1495 0.0375" euler="-0.7469 0 0"
                  rgba="1 0 0 1" contype="1" conaffinity="1"/>
            <geom name="pot_wall_neg_y" type="box" size="0.074 0.0075 0.04416"
                  pos="0 -0.1495 0.0375" euler="0.7469 0 0"
                  rgba="1 0 0 1" contype="1" conaffinity="1"/>
        </body>

        <!-- 纯视觉植物 + 隐藏的物理抓取胶囊体 -->
        <body name="plant" pos="0.5 0 0.4268">
            <freejoint name="plant_freejoint"/>
            <inertial pos="0 0 0.05" mass="0.1" diaginertia="0.0005 0.0005 0.0005"/>
            <geom type="mesh" mesh="my_plant_mesh" material="my_plant_mat" pos="0 0 0.0522" euler="1.5708 0 0" contype="0" conaffinity="0"/>
            <geom name="plant_collision" type="capsule" size="0.007" fromto="0 0 0.03 0 0 -0.05"
                  rgba="1 1 1 1" contype="1" conaffinity="1"/>
            <geom name="plant_root_collision" type="cylinder" size="0.022 0.005" pos="0 0 -0.12" rgba="1 1 1 0" contype="1" conaffinity="1"/>
        </body>
    </worldbody>
</mujoco>
