<mujoco>
    <include file="scene.xml"/>

    <asset>
        <mesh name="my_pot_mesh" file="plant_pot.stl" scale="0.002 0.005 0.001"/>
        <mesh name="my_plant_mesh" file="plant.stl" scale="0.04 0.04 0.04"/>
        <material name="my_pot_mat" rgba="0.8 0.45 0.3 1"/>
        <material name="my_plant_mat" rgba="0.2 0.6 0.1 1"/>
    </asset>

    <worldbody>
        <body name="pot" pos="0.5 0 0">
            <freejoint/>
            <inertial pos="0 0 0.05" mass="0.4" diaginertia="0.001 0.001 0.001"/>
            
            <geom type="mesh" mesh="my_pot_mesh" material="my_pot_mat" contype="0" conaffinity="0"/>
            
            <geom type="cylinder" size="0.08 0.02" pos="0 0 0.02" rgba="0.8 0.45 0.3 0" contype="1" conaffinity="1"/>
        </body>

        <body name="plant" pos="0.5 0 0.2">
            <freejoint/> 
            <inertial pos="0 0 0.05" mass="0.1" diaginertia="0.0005 0.0005 0.0005"/>
            
            <geom type="mesh" mesh="my_plant_mesh" material="my_plant_mat" euler="90 0 0" contype="0" conaffinity="0"/>
            
            <geom type="capsule" size="0.03 0.08" pos="0 0 0.05" rgba="1 1 1 0" contype="1" conaffinity="1"/>
        </body>
    </worldbody>
</mujoco>